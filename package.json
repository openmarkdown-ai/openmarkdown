{
  "name": "openmarkdown",
  "version": "0.1.0",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:wasm": "bash packages/engine/scripts/build-wasm.sh",
    "build": "npm run build:wasm && npm run build -w @vault/web && npm run build -w @vault/clipper",
    "build:web": "npm run build -w @vault/web",
    "dev": "npm run dev -w @vault/web",
    "typecheck": "tsc -p packages/app --noEmit && tsc -p apps/web --noEmit",
    "test:rust": "cargo test --workspace",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.0.280",
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "obsidian": "1.13.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "overrides": {
    "@codemirror/state": "6.7.4",
    "@codemirror/view": "6.43.11",
    "@codemirror/language": "6.12.4",
    "@lezer/common": "1.5.2",
    "@lezer/highlight": "1.2.3",
    "@lezer/lr": "1.4.10"
  }
}