{
  "id": "./",
  "name": "OpenMarkdown",
  "short_name": "OpenMarkdown",
  "description": "Markdown notes in the browser. Opens Obsidian vaults and runs their community plugins.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#ffffff",
  "theme_color": "#ffffff",
  "categories": ["productivity", "utilities"],
  "icons": [
    { "src": "./favicon.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "./icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "./icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "launch_handler": { "client_mode": ["focus-existing", "auto"] },
  "file_handlers": [
    {
      "action": "./?launch=file",
      "accept": {
        "text/markdown": [".md", ".markdown"],
        "application/json": [".canvas"],
        "application/yaml": [".base"]
      },
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png" }],
      "launch_type": "multiple-clients"
    }
  ],
  "protocol_handlers": [{ "protocol": "web+obsidian", "url": "./?uri=%s" }],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": ["image/*", "audio/*", "video/*", "application/pdf", "text/plain", "text/markdown", ".md", ".txt", ".pdf"]
        }
      ]
    }
  },
  "shortcuts": [
    { "name": "New quick note", "short_name": "Capture", "description": "Write a thought into today's daily note", "url": "./?capture=1", "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Today's daily note", "short_name": "Today", "url": "./?uri=obsidian%3A%2F%2Fdaily", "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "New note", "short_name": "New", "url": "./?uri=obsidian%3A%2F%2Fnew", "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }] }
  ],
  "note_taking": { "new_note_url": "./?capture=1" }
}
